rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function perfilExiste() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/usuarios_sistema/$(request.auth.uid));
    }

    function perfil() {
      return get(
        /databases/$(database)/documents/usuarios_sistema/$(request.auth.uid)
      ).data;
    }

    function papel() {
      return perfilExiste() ? perfil().role : null;
    }

    function ehAdm() {
      return papel() == "adm" || papel() == "admin";
    }

    function ehDiretor() {
      return papel() == "diretor";
    }

    function ehOperador() {
      return papel() == "operador";
    }

    function ehTerceirizada() {
      return papel() == "terceirizada";
    }

    function podeCadastrarOrdem() {
      return ehAdm() || ehDiretor() || ehOperador();
    }

    function ehCriadorDaOrdem() {
      return resource.data.createdByUid == request.auth.uid;
    }

    function criadorInformadoCorretamente() {
      return request.resource.data.createdByUid == request.auth.uid;
    }

    function camposOperacionaisTerceirizada() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "dataExecucao",
        "fotosExecucao",
        "slaPausas",
        "statusAntesAguardandoSanear",
        "updatedAt",
        "finalizadoPorArea",
        "finalizadoPorEmail",
        "finalizadoPorUid"
      ]);
    }

    function atualizacaoTerceirizadaPermitida() {
      return ehTerceirizada() && camposOperacionaisTerceirizada();
    }

    match /usuarios_sistema/{userId} {
      allow read: if estaLogado() &&
        (request.auth.uid == userId || ehAdm());

      allow create: if ehAdm();

      allow update: if ehAdm() || (
        estaLogado() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role
      );

      allow delete: if ehAdm() && request.auth.uid != userId;
    }

    match /notificacoes_usuario/{userId} {
      allow read, create, update: if estaLogado() && request.auth.uid == userId;
      allow delete: if ehAdm() || (estaLogado() && request.auth.uid == userId);
    }

    match /ordens_servico/{ordemId} {
      allow read: if estaLogado();

      allow create: if podeCadastrarOrdem() &&
        criadorInformadoCorretamente();

      allow update: if ehAdm() || ehDiretor() || atualizacaoTerceirizadaPermitida() ||
        (ehOperador() && ehCriadorDaOrdem());

      allow delete: if ehAdm();
    }

    match /ordensServico/{ordemId} {
      allow read: if estaLogado();

      allow create: if podeCadastrarOrdem() &&
        criadorInformadoCorretamente();

      allow update: if ehAdm() || ehDiretor() || atualizacaoTerceirizadaPermitida() ||
        (ehOperador() && ehCriadorDaOrdem());

      allow delete: if ehAdm();
    }

    match /ordensHidrojato/{ordemId} {
      allow read: if ehAdm() || ehDiretor() || ehOperador();

      allow create: if podeCadastrarOrdem() &&
        criadorInformadoCorretamente();

      allow update: if ehAdm() || ehDiretor() || ehOperador();

      allow delete: if ehAdm();
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
